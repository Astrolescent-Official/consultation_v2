#!/usr/bin/env sh
set -eu
branch=$(git branch --show-current)
git_dir=$(git rev-parse --git-dir)
case "$branch" in codex/*) ;; *) printf '%s\n' "Commits must be made on a codex/* branch." >&2; exit 1;; esac
if [ "$git_dir" = ".git" ]; then printf '%s\n' "Commits must be made from a linked worktree, not the primary checkout." >&2; exit 1; fi
