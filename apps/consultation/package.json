{
	"name": "consultation-dapp",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "CLOUDFLARE_ENV=preview vite dev --port 3000",
		"build": "vite build",
		"build:preview": "CLOUDFLARE_ENV=preview vite build",
		"deploy": "pnpm build && wrangler deploy --config dist/server/wrangler.json",
		"deploy:preview": "pnpm build:preview && wrangler deploy --config dist/server/wrangler.json",
		"cf:typegen": "wrangler types",
		"d1:migrate:local": "wrangler d1 migrations apply DB --local",
		"d1:migrate:preview": "wrangler d1 migrations apply DB --remote --env preview",
		"d1:migrate:production": "wrangler d1 migrations apply DB --remote",
		"tally": "tsx scripts/tally.ts",
		"preview": "vite preview",
		"check-types": "tsc --noEmit",
		"test": "vitest run --config vitest.config.ts",
		"test:worker": "vitest run --config vitest.worker.config.ts",
		"format": "biome format",
		"lint": "biome lint",
		"check": "biome check"
	},
